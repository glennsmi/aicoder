rules_version = '2';

// DEVELOPMENT RULES - DO NOT USE IN PRODUCTION
// These rules allow authenticated users to create their organizations and user documents
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ===== ORGANIZATIONS ===== 
    match /organizations/{orgId} {
      // Allow authenticated users to read and write organizations
      allow read, write: if isAuthenticated();
      
      match /members/{userId} {
        allow read, write: if isAuthenticated();
      }
      
      match /teams/{teamId} {
        allow read, write: if isAuthenticated();
      }
      
      match /apiConnections/{connectionId} {
        allow read, write: if isAuthenticated();
      }
      
      match /usage/{usageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // ===== SUBSCRIPTIONS =====
    match /subscriptions/{orgId} {
      allow read, write: if isAuthenticated();
    }
    
    // ===== INVITATIONS =====
    match /invitations/{inviteId} {
      allow read, write: if isAuthenticated();
    }
    
    // ===== USERS =====
    match /users/{userId} {
      allow read, write: if isAuthenticated();
      
      match /rawUsage/{usageId} {
        allow read, write, create, delete: if isUser(userId);
      }
      
      match /aggregatedUsage/{usageId} {
        allow read, write, create, delete: if isUser(userId);
      }
      
      match /enhancedRawUsage/{usageId} {
        allow read, write, create, delete: if isUser(userId);
      }
      
      match /enhancedAggregatedUsage/{usageId} {
        allow read, write, create, delete: if isUser(userId);
      }
      
      match /cursorUsage/{usageId} {
        allow read, write, create, delete: if isUser(userId);
      }
    }
    
    // ===== CURRENCY RATES =====
    match /currencyRates/{currencyCode} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ===== SYNC HISTORY =====
    match /syncHistory/{syncId} {
      allow read, write: if isAuthenticated();
    }
  }
}

